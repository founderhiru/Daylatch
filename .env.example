# Copy this file to .env.local for local development and fill in real values.
# Never commit .env, .env.local, or any other real secrets file — .gitignore
# already blocks every .env* variant except this example.

# Standard PostgreSQL connection string. Any Postgres works (a local instance,
# Supabase, Neon, etc.) — Prisma is the database layer regardless of host.
DATABASE_URL="postgresql://user:password@localhost:5432/daylatch"

# Server-only. Get a key at https://console.anthropic.com/ — used exclusively
# by src/lib/ai/client.ts (server-side). NEVER rename this to start with
# NEXT_PUBLIC_, and never reference it from a 'use client' file.
ANTHROPIC_API_KEY="sk-ant-..."

# The app's own public origin. Used for canonical URLs, OG/Twitter metadata,
# and the sitemap. Vercel deployments should set this to the real production
# domain once one exists; defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
